datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Creator {
  id          String   @id @default(uuid())
  slug        String   @unique // Link independiente ej: gachapay.com/c/nombre-creador
  name        String
  avatarUrl   String?
  gameType    String   @default("ROULETTE") // Uno de los 10 tipos de juegos
  createdAt   DateTime @default(now())
  rewards     Reward[]
  plays       PlayHistory[]
}

model Reward {
  id          String   @id @default(uuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name        String
  rarity      String   // 'C', 'R', 'SR', 'SSR'
  mediaUrl    String?  // URL de foto, video o archivo
  mediaType   String?  // 'IMAGE', 'VIDEO', 'FILE'
}

model PlayHistory {
  id        String   @id @default(uuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  userId    String
  rewardWon String
  rarity    String
  createdAt DateTime @default(now())
}
